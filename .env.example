# Способ 1: Вход по логину и паролю
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# Способ 2: Вход без пароля по cookie sessionid (если Instagram блокирует вход)
# Зайдите на instagram.com в браузере -> F12 -> Application -> Cookies -> sessionid
# INSTAGRAM_SESSIONID=ваш_sessionid_из_браузера
